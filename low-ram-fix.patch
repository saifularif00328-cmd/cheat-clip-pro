+    ENCODER_CONFIGS["qsv"] = ("h264_qsv", ["-c:v", "h264_qsv", "-preset", "veryfast", "-global_quality", "26",
+                                           "-look_ahead", "0", "-async_depth", "1", "-bf", "0"])
+
 _DETECTED_SUPPORT: Optional[Dict[str, Any]] = None
 
 
